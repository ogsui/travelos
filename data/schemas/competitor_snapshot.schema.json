{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "competitor_snapshot.schema.json",
  "title": "Synthetic competitor price snapshot",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^cmp_[0-9]{4}$" },
    "site": {
      "type": "string",
      "enum": ["makemytrip", "goibibo", "booking_com", "agoda", "easemytrip", "yatra"]
    },
    "query": { "$ref": "#/$defs/query" },
    "price_paise": { "type": ["integer", "null"], "minimum": 0 },
    "currency": { "type": "string", "enum": ["INR"] },
    "comparability_score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "status": { "type": "string", "enum": ["ok", "stale", "blocked", "unavailable"] },
    "fetched_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "payload_summary": { "type": "string" }
  },
  "required": [
    "id",
    "site",
    "query",
    "price_paise",
    "currency",
    "comparability_score",
    "status",
    "fetched_at",
    "payload_summary"
  ],
  "additionalProperties": false,
  "$defs": {
    "query": {
      "type": "object",
      "properties": {
        "origin": { "type": ["string", "null"] },
        "destination": { "type": "string", "minLength": 2 },
        "start_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "end_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "adults": { "type": "integer", "minimum": 1, "maximum": 30 },
        "children": { "type": "integer", "minimum": 0, "maximum": 20 },
        "rooms": { "type": "integer", "minimum": 1, "maximum": 20 }
      },
      "required": ["origin", "destination", "start_date", "end_date", "adults", "children", "rooms"],
      "additionalProperties": false
    }
  }
}
