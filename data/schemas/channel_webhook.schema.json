{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "channel_webhook.schema.json",
  "title": "Synthetic inbound channel webhook fixture",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^whk_[0-9]{4}$" },
    "channel": {
      "type": "string",
      "enum": ["whatsapp", "email", "instagram", "facebook", "google_business", "web_form"]
    },
    "event_type": { "type": "string", "enum": ["message", "status", "lead"] },
    "received_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "external_id": { "type": "string", "minLength": 4 },
    "signature_valid": { "type": "boolean" },
    "duplicate": { "type": "boolean" },
    "out_of_order": { "type": "boolean" },
    "expected_handling": {
      "type": "string",
      "enum": ["accept", "dedupe", "ignore", "stop", "media_download", "reject_signature"]
    },
    "payload": { "type": "object" }
  },
  "required": [
    "id",
    "channel",
    "event_type",
    "received_at",
    "external_id",
    "signature_valid",
    "duplicate",
    "out_of_order",
    "expected_handling",
    "payload"
  ],
  "additionalProperties": false
}
