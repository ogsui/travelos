{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quote.schema.json",
  "title": "Hand-built synthetic gold quote",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^quo_[0-9]{4}$" },
    "inquiry_id": { "type": "string", "pattern": "^inq_[0-9]{4}$" },
    "tier": { "type": "string", "enum": ["value", "standard", "premium"] },
    "currency": { "type": "string", "enum": ["INR"] },
    "components": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/component" }
    },
    "totals": { "$ref": "#/$defs/totals" },
    "expected": { "$ref": "#/$defs/expected" },
    "tax_note": { "type": "string" },
    "notes": { "type": "string" }
  },
  "required": [
    "id",
    "inquiry_id",
    "tier",
    "currency",
    "components",
    "totals",
    "expected",
    "tax_note",
    "notes"
  ],
  "additionalProperties": false,
  "$defs": {
    "component": {
      "type": "object",
      "properties": {
        "component_type": {
          "type": "string",
          "enum": ["flight", "hotel", "transfer", "activity", "visa", "insurance", "other"]
        },
        "description": { "type": "string", "minLength": 4 },
        "qty": { "type": "integer", "minimum": 1, "maximum": 30 },
        "cost_paise": { "type": "integer", "minimum": 0 },
        "price_paise": { "type": "integer", "minimum": 0 },
        "tax_paise": { "type": "integer", "minimum": 0 }
      },
      "required": ["component_type", "description", "qty", "cost_paise", "price_paise", "tax_paise"],
      "additionalProperties": false
    },
    "totals": {
      "type": "object",
      "properties": {
        "cost_paise": { "type": "integer", "minimum": 0 },
        "price_paise": { "type": "integer", "minimum": 0 },
        "tax_paise": { "type": "integer", "minimum": 0 },
        "total_paise": { "type": "integer", "minimum": 0 },
        "margin_paise": { "type": "integer" },
        "margin_bps": { "type": "integer", "minimum": 0 }
      },
      "required": ["cost_paise", "price_paise", "tax_paise", "total_paise", "margin_paise", "margin_bps"],
      "additionalProperties": false
    },
    "expected": {
      "type": "object",
      "properties": {
        "floor_price_paise": { "type": "integer", "minimum": 0 },
        "recommended_price_paise": { "type": "integer", "minimum": 0 }
      },
      "required": ["floor_price_paise", "recommended_price_paise"],
      "additionalProperties": false
    }
  }
}
