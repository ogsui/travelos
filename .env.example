# TravelOS environment. Copy to .env (never commit it).
# Every value here is local/synthetic. Secrets belong in a secret manager.

# test | shadow | live. Default is test.
MODE=test
# Must be exactly yes before live mode will start. Keep no everywhere else.
LIVE_CONFIRMED=no
ENVIRONMENT=local
DEBUG=false

APP_NAME=TravelOS
TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
LOG_JSON=true

# Reproducible seed for generated synthetic fixtures (task 007).
SYNTHETIC_SEED=20261025

# Local Docker defaults. Required (and checked) in live mode.
DATABASE_URL=postgresql+psycopg://travelos:travelos@localhost:5432/travelos
REDIS_URL=redis://localhost:6379/0
# Where synthetic fixtures are written. Unset means the repository's ./data.
# DATA_DIR=data
# SECRET_KEY=generate-a-32-plus-character-random-value
# PUBLIC_BASE_URL=https://travelos.example.com
# 32-byte URL-safe base64 key for field-level encryption. Generate with:
# python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# ENCRYPTION_KEY=replace-with-a-generated-key

# JSON list, e.g. ["http://localhost:3000"]
CORS_ORIGINS=[]

# --- Auth ---
# Server-side session lifetime in minutes (default 12 hours).
SESSION_TTL_MINUTES=720
# Label shown in authenticator apps.
MFA_ISSUER=TravelOS

# --- Background processing (task 004) ---
# Outbox retries: exponential backoff with jitter, then a human task.
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BACKOFF_SECONDS=10
OUTBOX_MAX_BACKOFF_SECONDS=3600
OUTBOX_JITTER=0.2
OUTBOX_BATCH_SIZE=25
OUTBOX_POLL_SECONDS=5
TIMER_BATCH_SIZE=100
TIMER_POLL_SECONDS=10

# --- Approvals (task 005) ---
# Unanswered requests escalate to the owner, then expire. Escalation must be
# shorter than the TTL; both are safety timings, not business policy.
APPROVAL_TTL_MINUTES=1440
APPROVAL_ESCALATION_MINUTES=30

# --- LLM gateway (task 006) ---
# The default chain is the deterministic fake provider. Test/shadow may use it;
# live mode refuses it and requires real keys, models and a daily budget.
LLM_PROVIDER_CHAIN=["fake"]
PROMPTS_DIR=prompts
LLM_MAX_ATTEMPTS=3
LLM_BACKOFF_SECONDS=1
LLM_TIMEOUT_SECONDS=30
# Owner policy: 0 = free providers only (explicit pricing.free), never "no cap".
# Live mode requires an explicit value; unset means no cap outside live.
# LLM_DAILY_BUDGET_PAISE=0
# Accounting day for the budget. Default is Indian Standard Time.
LLM_ACCOUNTING_TIMEZONE=Asia/Kolkata
# Redacted llm_calls rows are deleted by the nightly purge after this many days.
LLM_CALL_RETENTION_DAYS=90
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=300
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_RESET_SECONDS=60
LLM_FAKE_MODEL=fake-1
# OpenCode Zen free-tier models (official docs, 2026-10-24). To use them,
# uncomment LLM_PROVIDER/LLM_MODEL/LLM_FALLBACK_MODEL and set the key.
# LLM_PROVIDER=opencode
# LLM_MODEL=deepseek-v4.1-flash-free
# LLM_FALLBACK_MODEL=glm-5.3-flash-free
# LLM_OPENCODE_API_KEY=
LLM_OPENCODE_BASE_URL=https://opencode.ai/inference/openai/v1
# Reserved for the later reasoning/review step; not in the provider chain yet.
LLM_OPENCODE_REVIEW_MODEL=beam-free
LLM_OPENCODE_NO_TRAINING=true
LLM_OPENCODE_SYNTHETIC_ONLY=false
# OpenAI-compatible provider. Owner supplies the base URL, model and key.
# LLM_OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_OPENAI_MODEL=owner-selected-model
# LLM_OPENAI_API_KEY=
LLM_OPENAI_NO_TRAINING=true
LLM_OPENAI_SYNTHETIC_ONLY=false
# Published integer paise per million tokens. 0 means unpriced, not free.
LLM_OPENAI_INPUT_PAISE_PER_MILLION=0
LLM_OPENAI_OUTPUT_PAISE_PER_MILLION=0
# Anthropic provider. Owner supplies the base URL, model and key.
# LLM_ANTHROPIC_BASE_URL=https://api.anthropic.com
# LLM_ANTHROPIC_MODEL=owner-selected-model
# LLM_ANTHROPIC_API_KEY=
LLM_ANTHROPIC_VERSION=2023-06-01
LLM_ANTHROPIC_NO_TRAINING=true
LLM_ANTHROPIC_SYNTHETIC_ONLY=false
LLM_ANTHROPIC_INPUT_PAISE_PER_MILLION=0
LLM_ANTHROPIC_OUTPUT_PAISE_PER_MILLION=0
LLM_PRICING_CURRENCY=INR

# --- WhatsApp Business Cloud API (task 009d) ---
# Owner-supplied from the Meta Business app. Leave empty until Meta business
# verification and the approved template set exist. In shadow/live the webhook
# fails closed (503) without VERIFY_TOKEN and APP_SECRET; the adapter never
# sends in test or shadow regardless of these values.
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v18.0

# --- Kill switches: every capability is OFF unless explicitly enabled. ---
# Enabling a switch does not bypass consent, approvals or MODE checks.
# The environment switch is the deployment gate; the owner must also enable
# the matching row in /admin/flags. An OFF here can never be overridden by the API.
KILL_SWITCHES__WHATSAPP=false
KILL_SWITCHES__EMAIL=false
KILL_SWITCHES__SMS=false
KILL_SWITCHES__INSTAGRAM=false
KILL_SWITCHES__FACEBOOK=false
KILL_SWITCHES__GOOGLE_BUSINESS=false
KILL_SWITCHES__WEB_FORM=false
KILL_SWITCHES__PHONE_LOG=false
KILL_SWITCHES__COLD_OUTREACH=false
KILL_SWITCHES__SOCIAL_PUBLISHING=false
KILL_SWITCHES__ADS=false
KILL_SWITCHES__COMPETITOR_SCRAPING=false
KILL_SWITCHES__PORTAL_AUTOMATION=false
KILL_SWITCHES__SCRAPER_MAKEMYTRIP=false
KILL_SWITCHES__SCRAPER_GOIBIBO=false
KILL_SWITCHES__SCRAPER_BOOKING_COM=false
KILL_SWITCHES__SCRAPER_AGODA=false
KILL_SWITCHES__SCRAPER_EASEMYTRIP=false
KILL_SWITCHES__SCRAPER_YATRA=false

# --- Docker Compose development only ---
POSTGRES_PASSWORD=travelos
MINIO_ROOT_USER=travelos
MINIO_ROOT_PASSWORD=travelos-dev-only
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
